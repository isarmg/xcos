{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "singleton",
    "lease_owner",
    "lease_expires_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "singleton": {
      "type": "integer",
      "const": 1
    },
    "lease_owner": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ]
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time",
          "maxLength": 35,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.(?:(?:[0-9]{2}[1-9]|[0-9][1-9][0-9]|[1-9][0-9]{2})|[0-9]{3}(?:[0-9]{2}[1-9]|[0-9][1-9][0-9]|[1-9][0-9]{2})|[0-9]{6}(?:[0-9]{2}[1-9]|[0-9][1-9][0-9]|[1-9][0-9]{2})))?\\+00:00$"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.(?:(?:[0-9]{2}[1-9]|[0-9][1-9][0-9]|[1-9][0-9]{2})|[0-9]{3}(?:[0-9]{2}[1-9]|[0-9][1-9][0-9]|[1-9][0-9]{2})|[0-9]{6}(?:[0-9]{2}[1-9]|[0-9][1-9][0-9]|[1-9][0-9]{2})))?\\+00:00$"
    }
  },
  "if": {
    "properties": {
      "lease_owner": {
        "type": "null"
      }
    }
  },
  "then": {
    "properties": {
      "lease_expires_at": {
        "type": "null"
      }
    }
  },
  "else": {
    "properties": {
      "lease_expires_at": {
        "type": "string",
        "format": "date-time",
        "maxLength": 35,
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.(?:(?:[0-9]{2}[1-9]|[0-9][1-9][0-9]|[1-9][0-9]{2})|[0-9]{3}(?:[0-9]{2}[1-9]|[0-9][1-9][0-9]|[1-9][0-9]{2})|[0-9]{6}(?:[0-9]{2}[1-9]|[0-9][1-9][0-9]|[1-9][0-9]{2})))?\\+00:00$"
      }
    }
  }
}
