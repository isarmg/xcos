[Unit]
Description=Xcos pinned MediaMTX companion
PartOf=xcos.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=isarmg-xcos
Group=isarmg-xcos
WorkingDirectory=/opt/isarmg/xcos
UMask=0077
EnvironmentFile=/opt/isarmg/xcos/config/mediamtx.env
ExecStart=/opt/isarmg/xcos/bin/mediamtx /opt/isarmg/xcos/config/mediamtx.yml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/isarmg/xcos/state /opt/isarmg/xcos/logs /opt/isarmg/xcos/run
