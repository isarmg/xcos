[Unit]
Description=Xcos pinned MediaMTX companion
PartOf=xcos.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=isarmg-xcos
Group=isarmg-xcos
WorkingDirectory=/
UMask=0077
RuntimeDirectory=isarmg/xcos
RuntimeDirectoryMode=0700
# The companion stops last and owns final shared-runtime cleanup.
RuntimeDirectoryPreserve=restart
EnvironmentFile=/etc/isarmg/xcos/mediamtx.env
ExecStartPre=/bin/sh -ec '/opt/isarmg/xcos/bin/xcos --config /etc/isarmg/xcos/config.json media-config > /run/isarmg/xcos/mediamtx.yml'
ExecStartPre=/bin/chmod 0600 /run/isarmg/xcos/mediamtx.yml
ExecStart=/opt/isarmg/xcos/bin/mediamtx /run/isarmg/xcos/mediamtx.yml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/isarmg/xcos /run/isarmg/xcos
