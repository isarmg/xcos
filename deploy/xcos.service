[Unit]
Description=xcos
Requires=xcos-mediamtx.service
After=network-online.target xcos-mediamtx.service
Wants=network-online.target

[Service]
Type=simple
User=isarmg-xcos
Group=isarmg-xcos
WorkingDirectory=/opt/isarmg/xcos
UMask=0077
ExecStart=/opt/isarmg/xcos/bin/xcos --root /opt/isarmg/xcos
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/isarmg/xcos/state /opt/isarmg/xcos/logs /opt/isarmg/xcos/run

[Install]
WantedBy=multi-user.target
