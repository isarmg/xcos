[Unit]
Description=xcos
Requires=xcos-mediamtx.service
After=network-online.target xcos-mediamtx.service
Wants=network-online.target

[Service]
Type=simple
User=isarmg-xcos
Group=isarmg-xcos
WorkingDirectory=/
UMask=0077
RuntimeDirectory=isarmg/xcos
RuntimeDirectoryMode=0700
# The application stops first; only the companion removes the shared directory.
RuntimeDirectoryPreserve=yes
ExecStartPre=/opt/isarmg/xcos/bin/xcos --config /etc/isarmg/xcos/config.json check
ExecStart=/opt/isarmg/xcos/bin/xcos --config /etc/isarmg/xcos/config.json run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/isarmg/xcos /run/isarmg/xcos

[Install]
WantedBy=multi-user.target
