{
  "name": "xcos-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "scripts": {
    "dev": "cargo +1.99.0 run --quiet --locked --manifest-path ../tools/web-build/Cargo.toml -- serve --product-root .. --debug --bind 127.0.0.1:5173",
    "typecheck": "cargo +1.99.0 run --quiet --locked --manifest-path ../tools/web-build/Cargo.toml -- check --product-root ..",
    "check:xcss": "node tests/design-xcss.test.mjs",
    "test:unit": "npm run test:rust",
    "build": "cargo +1.99.0 run --quiet --locked --manifest-path ../tools/web-build/Cargo.toml -- build --product-root ..",
    "test:browser": "npm run build && node tests/browser-acceptance.mjs && node tests/camera-clock-browser.mjs && node tests/xcss-web-media.mjs && node tests/xcss-web-startup.mjs && node tests/xcss-web-concurrency.mjs",
    "test:camera-clock": "npm run build && node tests/camera-clock-browser.mjs",
    "build:server": "cargo +1.99.0 run --quiet --locked --manifest-path ../tools/web-build/Cargo.toml -- server --product-root .. --config xcss-web-build.json --mode development",
    "test:rust": "cargo +1.99.0 run --quiet --locked --manifest-path ../tools/web-build/Cargo.toml -- test --product-root ..",
    "preview": "cargo +1.99.0 run --quiet --locked --manifest-path ../tools/web-build/Cargo.toml -- preview --product-root .. --bind 127.0.0.1:4173",
    "test:startup": "node tests/startup-failure.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@xcss/web": "https://github.com/isarmg/xcss/releases/download/v1.0.0/xcss-web-1.0.0.tgz",
    "hls.js": "1.6.13"
  }
}
